# ================================================================
#  环境变量示例文件 (.env.example)
# ================================================================
#  使用方法：
#    1. 复制这个文件，重命名为 .env（注意前面有个点）
#    2. 把 your_sendkey_here 替换成你自己的 SendKey
#
#  SendKey 获取地址：https://sct.ftqq.com/
#  登录后点击「SendKey」即可看到你的 key
#
#  注意：.env 文件包含敏感信息，不要上传到 Gitee！
#  （.gitignore 已经配置了忽略 .env 文件）
# ================================================================
 
SC_SENDKEY=your_sendkey_here
